rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المستخدمون يقرؤون/يكتبون ملفاتهم الشخصية فقط
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // الإعلانات: القراءة للجميع، الكتابة للمسجلين
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    // رموز التحقق للتسجيل: الكتابة للجميع (غير مسجل)، القراءة للجميع
    match /email_verifications/{email} {
      allow read, write: if true;
    }

    // رموز إعادة تعيين كلمة المرور
    match /password_resets/{email} {
      allow read, write: if true;
    }

    // الإشعارات
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null;
    }

    // المحادثات والرسائل
    match /conversations/{convId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // باقي المجموعات للمسجلين
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email in [
        'mohamm3dalfeel@gmail.com',
        'kog24kog@gmail.com'
      ];
    }
  }
}
